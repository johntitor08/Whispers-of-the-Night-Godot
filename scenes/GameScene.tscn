[node name="StoryBText" type="Control" parent="StoryCanvas/StoryCanvas/StoryPanel/StoryBPanel"]
script = ExtResource("42")
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -530.0
offset_top = -330.0
offset_right = 530.0
