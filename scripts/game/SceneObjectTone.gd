var image
var baseColor := Color.WHITE
var lastBackground

func Awake() -> void:
	image = gameObject
	baseColor = image.color

func OnEnable() -> void:
	Apply(true)

func LateUpdate() -> void:
	Apply(false)

func Apply(force: bool) -> void:
	if image == null or SceneEvent.Instance == null or SceneEvent.Instance.backgroundImage == null:
		return
	var bg = SceneEvent.Instance.backgroundImage.sprite
	if not force and bg == lastBackground:
		return
	lastBackground = bg
	var tint: Color = Tints.get(bg.name, Color.WHITE) if bg != null else Color.WHITE
	image.color = Color(baseColor.r * tint.r, baseColor.g * tint.g, baseColor.b * tint.b, baseColor.a)
