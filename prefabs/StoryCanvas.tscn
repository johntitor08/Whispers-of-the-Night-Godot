[node name="StoryBText" type="Control" parent="StoryPanel/StoryBPanel"]
script = ExtResource("5")
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -530.0
offset_top = -330.0
offset_right = 530.0
offset_bottom = 230.0
visible = true
mouse_filter = 2
metadata/pivot = [0.5, 0.5]
metadata/u = "{\"text\":{\"enabled\":true,\"text\":\"Story B - The Foreign Echo:\\n\\nYou arrived in Ashenveil from a dimension you can no longer name. The crossing left you fractured - you exist between spaces, hearing whispers no one else can. You don't know why Ashenveil pulled you here. But every whisper carries the same name: Voss. A stranger in every world - which makes you the only one who can see the system from outside.\\n\\nWhisper: \\\"You are not from here. That is exactly why you matter.\\\"\\n\\nStats: SPD 90 · MANA 80 · ATK 55 · HP 40\",\"color\":[0.97,0.94,0.88,1],\"vertexColor\":[1,1,1,1],\"fontSize\":26,\"autoSize\":false,\"minSize\":18,\"maxSize\":72,\"style\":0,\"halign\":2,\"valign\":512,\"wrap\":true,\"overflow\":0,\"margin\":[0,0,0,0],\"lineSpacing\":6,\"charSpacing\":0,\"wordSpacing\":5,\"paragraphSpacing\":0,\"raycastTarget\":true,\"rich\":true,\"font\":{\"ttf\":\"res://Assets/Asset Store/Gentleland/SteampunkUI/Fonts/RobotoSlab/RobotoSlab.ttf\",\"fallbacks\":[\"res://Assets/Asset Store/Gentleland/SteampunkUI/Fonts/RobotoSlab/RobotoSlab.ttf\"],\"name\":\"RobotoSlab SDF.asset\"}},\"name\":\"StoryBText\",\"tag\":\"Untagged\",\"layer\":5}"

[node name="C_LocalizedText" type="Node" parent="StoryPanel/StoryBPanel/StoryBText"]
script = ExtResource("6")
metadata/u = "{\"m_Enabled\":1,\"en\":\"Story B - The Foreign Echo:\\n\\nYou arrived in Ashenveil from a dimension you can no longer name. The crossing left you fractured - you exist between spaces, hearing whispers no one else can. You don't know why Ashenveil pulled you here. But every whisper carries the same name: Voss. A stranger in every world - which makes you the only one who can see the system from outside.\\n\\nWhisper: \\\"You are not from here. That is exactly why you matter.\\\"\\n\\nStats: SPD 90 · MANA 80 · ATK 55 · HP 40\",\"tr\":\"Köken B - Yabancı Yankı:\\n\\nArtık adını koyamadığın bir boyuttan Ashenveil'e geldin. Geçiş seni parçaladı — mekânlar arasında var oluyorsun, başkasının duyamadığı fısıltıları duyuyorsun. Ashenveil'in seni buraya neden çektiğini bilmiyorsun. Ama her fısıltı aynı adı taşıyor: Voss. Her dünyada bir yabancı — bu da seni sistemi dışarıdan görebilen tek kişi yapıyor.\\n\\nFısıltı: \\\"Buralı değilsin. İşte tam da bu yüzden önemlisin.\\\"\\n\\nİstatistikler: SPD 90 · MANA 80 · ATK 55 · HP 40\",\"$type\":\"LocalizedText\"}"

