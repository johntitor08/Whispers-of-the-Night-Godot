metadata/pivot = [0.5, 0.5]
metadata/u = "{\"text\":{\"enabled\":true,\"text\":\"The world has no name, but it has rules. Once, the world listened to human words and held them binding. After a long period known as the Great Silence, a mysterious figure named Voss introduced a binding \\\"Contract System\\\" to shape reality. But in this new order, every gain demands a hidden, soul-consuming price paid in Axios energy. In Whispers of the Night, players navigate the foggy paths of Ashenveil. At the start of the game, you must choose your origin, determining how you perceive the whispers and how you will face Voss’s inescapable system.\",\"color\":[0.97,0.94,0.88,1],\"vertexColor\":[1,1,1,1],\"fontSize\":24,\"autoSize\":false,\"minSize\":18,\"maxSize\":72,\"style\":0,\"halign\":2,\"valign\":512,\"wrap\":true,\"overflow\":0,\"margin\":[0,0,0,0],\"lineSpacing\":6,\"charSpacing\":5,\"wordSpacing\":0,\"paragraphSpacing\":0,\"raycastTarget\":true,\"rich\":true,\"font\":{\"ttf\":\"res://Assets/Asset Store/Gentleland/SteampunkUI/Fonts/RobotoSlab/RobotoSlab.ttf\",\"fallbacks\":[\"res://Assets/Asset Store/Gentleland/SteampunkUI/Fonts/RobotoSlab/RobotoSlab.ttf\"],\"name\":\"RobotoSlab SDF.asset\"}},\"name\":\"MainStoryText\",\"tag\":\"Untagged\",\"layer\":5}"

[node name="C_LocalizedText" type="Node" parent="StoryPanel/MainStoryPanel/MainStoryTextPanel/MainStoryText"]
script = ExtResource("6")
metadata/u = "{\"m_Enabled\":1,\"en\":\"The world has no name, but it has rules. Once, the world listened to human words and held them binding. After a long period known as the Great Silence, a mysterious figure named Voss introduced a binding \\\"Contract System\\\" to shape reality. But in this new order, every gain demands a hidden, soul-consuming price paid in Axios energy. In Whispers of the Night, players navigate the foggy paths of Ashenveil. At the start of the game, you must choose your origin, determining how you perceive the whispers and how you will face Voss’s inescapable system.\",\"tr\":\"Dünyanın bir adı yok ama kuralları var. Bir zamanlar dünya insan sözlerini dinler ve onları bağlayıcı tutardı. Büyük Sessizlik olarak bilinen uzun bir dönemin ardından, Voss adında gizemli bir figür gerçekliği şekillendirmek için bağlayıcı bir \\\"Sözleşme Sistemi\\\" getirdi. Ama bu yeni düzende her kazanç, Axios enerjisiyle ödenen gizli, ruh tüketen bir bedel ister. Whispers of the Night'ta oyuncular Ashenveil'in sisli yollarında ilerler. Oyunun başında kökenini seçmelisin; bu, fısıltıları nasıl algıladığını ve Voss'un kaçınılmaz sistemiyle nasıl yüzleşeceğini belirler.\",\"$type\":\"LocalizedText\"}"

