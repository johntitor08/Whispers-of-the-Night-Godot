metadata/u = "{\"text\":{\"enabled\":true,\"text\":\"Story C - The Sinned Guardian:\\n\\nYou were Ashenveil's protector - until you made a deal with Voss to save the village from plague. The village survived. Three families did not. You chose them. Shadow Garden recruited you not for your strength - but for your guilt.\\n\\nWhisper: \\\"The ones you gave away - they are still out there. Voss does not destroy. He collects.\\\" - Maren\\n\\nStats: HP 85 · ATK 80 · DEF 65 · MANA 35\",\"color\":[0.97,0.94,0.88,1],\"vertexColor\":[1,1,1,1],\"fontSize\":26,\"autoSize\":false,\"minSize\":18,\"maxSize\":72,\"style\":0,\"halign\":2,\"valign\":512,\"wrap\":true,\"overflow\":0,\"margin\":[0,0,0,0],\"lineSpacing\":6,\"charSpacing\":0,\"wordSpacing\":5,\"paragraphSpacing\":0,\"raycastTarget\":true,\"rich\":true,\"font\":{\"ttf\":\"res://Assets/Asset Store/Gentleland/SteampunkUI/Fonts/RobotoSlab/RobotoSlab.ttf\",\"fallbacks\":[\"res://Assets/Asset Store/Gentleland/SteampunkUI/Fonts/RobotoSlab/RobotoSlab.ttf\"],\"name\":\"RobotoSlab SDF.asset\"}},\"name\":\"StoryCText\",\"tag\":\"Untagged\",\"layer\":5}"

[node name="C_LocalizedText" type="Node" parent="StoryPanel/StoryCPanel/StoryCText"]
script = ExtResource("6")
metadata/u = "{\"m_Enabled\":1,\"en\":\"Story C - The Sinned Guardian:\\n\\nYou were Ashenveil's protector - until you made a deal with Voss to save the village from plague. The village survived. Three families did not. You chose them. Shadow Garden recruited you not for your strength - but for your guilt.\\n\\nWhisper: \\\"The ones you gave away - they are still out there. Voss does not destroy. He collects.\\\" - Maren\\n\\nStats: HP 85 · ATK 80 · DEF 65 · MANA 35\",\"tr\":\"Köken C - Günahkâr Muhafız:\\n\\nAshenveil'in koruyucusuydun — ta ki köyü vebadan kurtarmak için Voss'la bir anlaşma yapana dek. Köy hayatta kaldı. Üç aile kalmadı. Onları sen seçtin. Shadow Garden seni gücün için değil — suçluluğun için topladı.\\n\\nFısıltı: \\\"Verdiğin kişiler — hâlâ dışarıdalar. Voss yok etmez. Toplar.\\\" - Maren\\n\\nİstatistikler: HP 85 · ATK 80 · DEF 65 · MANA 35\",\"$type\":\"LocalizedText\"}"

