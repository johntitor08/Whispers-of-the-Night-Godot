metadata/pivot = [0.5, 0.5]
metadata/u = "{\"text\":{\"enabled\":true,\"text\":\"Story A - The Bound Archivist:\\n\\nYou were a keeper of records in Eyes of Wisdom's archive - until a sealed contract file bore your name. Not as author. As subject. Voss signed you into his system before you were born. You carry the archive's knowledge and its deepest secret: the location of Voss's first contract.\\n\\nWhisper: \\\"Every record has a keeper. Every keeper has a price.\\\"\\n\\nStats: MANA 90 · RP 85 · ATK 45 · HP 55\",\"color\":[0.97,0.94,0.88,1],\"vertexColor\":[1,1,1,1],\"fontSize\":26,\"autoSize\":false,\"minSize\":18,\"maxSize\":72,\"style\":0,\"halign\":2,\"valign\":512,\"wrap\":true,\"overflow\":0,\"margin\":[0,0,0,0],\"lineSpacing\":6,\"charSpacing\":0,\"wordSpacing\":5,\"paragraphSpacing\":0,\"raycastTarget\":true,\"rich\":true,\"font\":{\"ttf\":\"res://Assets/Asset Store/Gentleland/SteampunkUI/Fonts/RobotoSlab/RobotoSlab.ttf\",\"fallbacks\":[\"res://Assets/Asset Store/Gentleland/SteampunkUI/Fonts/RobotoSlab/RobotoSlab.ttf\"],\"name\":\"RobotoSlab SDF.asset\"}},\"name\":\"StoryAText\",\"tag\":\"Untagged\",\"layer\":5}"

[node name="C_LocalizedText" type="Node" parent="StoryPanel/StoryAPanel/StoryAText"]
script = ExtResource("6")
metadata/u = "{\"m_Enabled\":1,\"en\":\"Story A - The Bound Archivist:\\n\\nYou were a keeper of records in Eyes of Wisdom's archive - until a sealed contract file bore your name. Not as author. As subject. Voss signed you into his system before you were born. You carry the archive's knowledge and its deepest secret: the location of Voss's first contract.\\n\\nWhisper: \\\"Every record has a keeper. Every keeper has a price.\\\"\\n\\nStats: MANA 90 · RP 85 · ATK 45 · HP 55\",\"tr\":\"Köken A - Bağlı Arşivci:\\n\\nEyes of Wisdom'ın arşivinde bir kayıt bekçisiydin — ta ki mühürlü bir sözleşme dosyası senin adını taşıyana dek. Yazar olarak değil. Konu olarak. Voss seni doğmadan önce sistemine imzaladı. Arşivin bilgisini ve en derin sırrını taşıyorsun: Voss'un ilk sözleşmesinin yerini.\\n\\nFısıltı: \\\"Her kaydın bir bekçisi vardır. Her bekçinin bir bedeli.\\\"\\n\\nİstatistikler: MANA 90 · RP 85 · ATK 45 · HP 55\",\"$type\":\"LocalizedText\"}"

